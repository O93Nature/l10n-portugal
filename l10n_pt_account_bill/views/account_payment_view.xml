<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Botão "Anular Recibo" no formulário do pagamento. Só aparece quando o
         pagamento tem recibo certificado no BILL e ainda não está anulado. -->
    <record model="ir.ui.view" id="view_account_payment_form_bill_cancel">
        <field name="name">account.payment.form.bill.cancel</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="fm_has_bill_receipt" invisible="1" />
                <button name="action_open_receipt_cancel_wizard"
                        string="Anular Recibo"
                        type="object"
                        class="btn-outline-danger"
                        invisible="fm_has_bill_receipt == False"/>
            </xpath>
        </field>
    </record>

    <!-- Diálogo de confirmação (pede o motivo). -->
    <record id="view_payment_receipt_cancel_wizard_form" model="ir.ui.view">
        <field name="name">account.payment.receipt.cancel.wizard.form</field>
        <field name="model">account.payment.receipt.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Anulação do Recibo">
                <group>
                    <field name="reason"
                           placeholder="Informe o motivo da anulação (obrigatório)"/>
                </group>
                <footer>
                    <button string="Confirmar" type="object"
                            name="action_confirm_cancel" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
